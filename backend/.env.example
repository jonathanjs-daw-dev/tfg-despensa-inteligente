# Base de datos
DATABASE_URL="postgresql://user:12345@localhost:5432/despensa"

# Servidor
PORT=3000

# JWT — cambiar por strings largos y aleatorios en producción
JWT_ACCESS_SECRET="access_secret_dev"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="refresh_secret_dev"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS — origen permitido (URL del frontend)
CORS_ORIGIN="http://localhost:5173"

# Entorno
NODE_ENV=development

# IA — obtener en https://aistudio.google.com/app/apikey
GEMINI_API_KEY="tu_api_key_de_gemini_aqui"

# Imágenes — obtener en https://www.pexels.com/api/
PEXELS_API_KEY="tu_api_key_de_pexels_aqui"
